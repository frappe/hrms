 "client_script": "// the Job Opening field is filled from the link, so show the title of the opening instead of its ID\nconst job_opening = frappe.utils.get_query_params().job_title;\nconst job_opening_title = frappe.web_form_doc.job_opening_title;\n\nif (job_opening && job_opening_title) {\n\tconst field = frappe.web_form.fields_dict.job_title;\n\t// read-only values reach the formatter already escaped\n\tfield.df.formatter = (value) =>\n\t\tvalue === frappe.utils.escape_html(job_opening)\n\t\t\t? frappe.utils.escape_html(job_opening_title)\n\t\t\t: value;\n\n\tif (field.value) field.set_input(field.value);\n}\n\nfrappe.web_form.on(\"resume_link\", (field, value) => {\n\tif (!frappe.utils.is_url(value)) {\n\t\tfrappe.msgprint(__(\"Resume link not valid\"));\n\t}\n});\n",

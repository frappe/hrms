 "client_script": "frappe.web_form.after_load = () => {\n\tconst job_opening = frappe.utils.get_query_params().job_title;\n\tif (job_opening) {\n\t\tfrappe.call({\n\t\t\tmethod: \"frappe.client.get_value\",\n\t\t\targs: {\n\t\t\t\tdoctype: \"Job Opening\",\n\t\t\t\tfilters: job_opening,\n\t\t\t\tfieldname: \"job_title\",\n\t\t\t},\n\t\t\tcallback: (r) => {\n\t\t\t\tif (!r?.message) return;\n\t\t\t\t$(frappe.web_form.fields_dict[\"job_title\"].wrapper)\n\t\t\t\t\t.find(\".control-value\")\n\t\t\t\t\t.text(r.message.job_title);\n\t\t\t},\n\t\t});\n\t}\n\n\tfrappe.call({\n\t\tmethod: \"hrms.hr.doctype.job_applicant.job_applicant.get_job_application_settings\",\n\t\tcallback: (r) => {\n\t\t\tif (!r?.message?.enable_recaptcha || !r?.message?.recaptcha_site_key) return;\n\n\t\t\tconst siteKey = r.message.recaptcha_site_key;\n\t\t\tconst el = document.querySelector('[data-fieldname=\"recaptcha_html\"]');\n\t\t\t$(el).empty();\n\t\t\tlet recaptchaFailed = true;\n\n\t\t\twindow.onRecaptchaLoad = function () {\n\t\t\t\tgrecaptcha.render(el, {\n\t\t\t\t\tsitekey: siteKey,\n\t\t\t\t\tcallback: (token) => {\n\t\t\t\t\t\trecaptchaFailed = false;\n\t\t\t\t\t\tfrappe.web_form.set_value(\"recaptcha_response\", token);\n\t\t\t\t\t},\n\t\t\t\t});\n\t\t\t};\n\n\t\t\tfrappe.require(\n\t\t\t\t\"https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoad&render=explicit&type=api.js\"\n\t\t\t);\n\n\t\t\tconst _save = frappe.web_form.save.bind(frappe.web_form);\n\t\t\tfrappe.web_form.save = function (...args) {\n\t\t\t\tif (recaptchaFailed) {\n\t\t\t\t\tfrappe.msgprint({\n\t\t\t\t\t\ttitle: __(\"Verification Required\"),\n\t\t\t\t\t\tmessage: __(\"Please complete the reCAPTCHA verification.\"),\n\t\t\t\t\t\tindicator: \"red\",\n\t\t\t\t\t});\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\t\t\t\treturn _save(...args);\n\t\t\t};\n\t\t},\n\t});\n};\n\nfrappe.web_form.on(\"resume_link\", (field, value) => {\n\tif (!frappe.utils.is_url(value)) {\n\t\tfrappe.msgprint(__(\"Resume link not valid\"));\n\t}\n});\n",

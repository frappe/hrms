      "dimension_name": "Designation"
     }
    ],
    "values": [
     {
      "data_type": "Decimal",
      "expression": {
       "expression": "sum_if(start_date >= date_sub(month_start(today()), 1, 'month'), gross_pay)",
       "type": "expression"
      },
      "format": "currency",
      "measure_name": "Last Month"
     },
     {
      "data_type": "Decimal",
      "expression": {
       "expression": "sum_if(start_date <= date_sub(date_sub(month_start(today()), 1, 'day'), 1, 'year'), gross_pay)",
       "type": "expression"
      },
      "format": "currency",
      "measure_name": "Same Month Last Year"
     },
     {
      "data_type": "Decimal",
      "expression": {
       "expression": "(sum_if(start_date >= date_sub(month_start(today()), 1, 'month'), gross_pay) - sum_if(start_date <= date_sub(date_sub(month_start(today()), 1, 'day'), 1, 'year'), gross_pay)) / sum_if(start_date <= date_sub(date_sub(month_start(today()), 1, 'day'), 1, 'year'), gross_pay)",
       "type": "expression"
      },
      "format": "percent",
      "measure_name": "Change"
     }
    ]
   },
